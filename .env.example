# 环境变量示例 —— 复制为 .env 并填入你自己的密钥（.env 已被 .gitignore 忽略）
#
# 用法：  set -a; source .env; set +a
# 或直接： export HF_TOKEN=... ; export WANDB_API_KEY=...

# HuggingFace 访问令牌（下载 SD3.5 / 蓝队 VLM / 裁判模型需要）
HF_TOKEN=your_huggingface_token_here

# Weights & Biases 密钥（用于训练曲线记录）
# 获取: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here
